.DS_Store
node_modules

# promptfoo writes its run output and cache here; a run costs subscription time
# and its verdict is read by a person, so nothing about it belongs in git.
evals/*/output/
.promptfoo/

# Agent state — per machine, per session. Agent settings are tracked; this is
# not (ADR 0008).
.claude/worktrees/
.claude/settings.local.json
.cache/

# Nx
.nx/cache
.nx/workspace-data
.nx/migrate-runs
