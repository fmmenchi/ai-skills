{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "tags": [
      "scope:app",
      "type:site"
    ],
    "targets": {
      "config-generator": {
        "executor": "@fmmenchi/nx-docusaurus:config-generator",
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "sync-docs": {
        "executor": "@fmmenchi/nx-docusaurus:sync-docs",
        "dependsOn": [
          "config-generator"
        ],
        "cache": false,
        "options": {
          "targetPath": "apps/docusaurus/docs"
        }
      },
      "watch-sync-docs": {
        "executor": "@fmmenchi/nx-docusaurus:sync-docs",
        "dependsOn": [
          "config-generator"
        ],
        "continuous": true,
        "cache": false,
        "options": {
          "targetPath": "apps/docusaurus/docs",
          "watch": true
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "watch-sync-docs"
        ],
        "options": {
          "command": "docusaurus start",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "//": "The generator's inputs are {projectRoot} only, and this site serves files outside it: README.md, doc/adr/ and skills/ (docusaurus.config.ts, `include`). Measured: an ADR edit was served a cache hit and the stale site. Keep this list in step with that `include`.",
        "executor": "nx:run-commands",
        "dependsOn": [
          "sync-docs"
        ],
        "options": {
          "command": "docusaurus build",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*",
          "{workspaceRoot}/README.md",
          "{workspaceRoot}/doc/adr/*.md",
          "{workspaceRoot}/skills/**/*"
        ]
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docusaurus serve",
          "cwd": "{projectRoot}"
        }
      },
      "clear": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "docusaurus clear",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fmmenchi/nx-docusaurus": "0.0.20"
  }
}
